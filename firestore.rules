rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm trợ giúp kiểm tra xác thực
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Bộ sưu tập Người dùng (users)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Bộ sưu tập Ngân hàng Đề thi (exams)
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Bộ sưu tập Bài nộp & Kết quả thi của học sinh (submissions)
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Bộ sưu tập Phòng thi trực tuyến thời gian thực (liveRooms)
    match /liveRooms/{roomId} {
      allow read, write: if true;
    }

    // Cho phép tất cả các tài liệu khác phục vụ học tập & thi cử
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
